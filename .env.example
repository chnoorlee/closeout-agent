# Gemini API mode (local)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Vertex AI mode (Google Cloud)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
CLOSEOUT_MODEL=gemini-3.5-flash

# Runtime adapters: auto | memory | firestore, and auto | local | cloud-tasks
CLOSEOUT_STORE=auto
CLOSEOUT_DISPATCHER=auto
CLOSEOUT_TASKS_QUEUE=closeout-runs
CLOSEOUT_TASKS_LOCATION=us-central1
CLOSEOUT_SERVICE_URL=
CLOSEOUT_TASK_SERVICE_ACCOUNT=
CLOSEOUT_TASK_SECRET=

# Demo controls
CLOSEOUT_DEMO_MODE=true
CLOSEOUT_STAGE_DELAY_MS=450
